#}

image emmc.img{
  size = 14G
  hdimage {
	gpt = "true"
	gpt-location = 7M
	disk-uuid = 8da16a96-64cb-44ef-9bd7-43cea57d091c
	gpt-no-backup = "true"
  }

  partition imx-boot {
    in-partition-table = "no"
    image = "imx8-boot-sd.bin"
    offset = %IMXOFFSET%
  }

#  partition uboot-env1 {
#	in-partition-table = "no"
#	offset = 4M
#	size = 1M
#  }

#  partition uboot-env2 {
#	in-partition-table = "no"
#	offset = 5M
#	size = 1M
#  }

  partition rootfs {
	partition-type-uuid = 0fc63daf-8483-4772-8e79-3d69d8477de4
	partition-uuid = 70f29e13-761e-461d-8a65-991d765941b7
	offset = 8M
	size = %BR2_TARGET_ROOTFS_EXT2_SIZE%
  }

  partition usr {
	partition-type-uuid = 0fc63daf-8483-4772-8e79-3d69d8477de4
	partition-uuid = 56d2e551-db06-46da-bb58-274c6ee725d2
	autoresize = "true"
  }
}


image boot.vfat {
  vfat {
    label = "boot"
    files = {
      emmc.img,
	  rootfs.ext4.gz,
    }
  }
  size = 512M
}

image sdcard_burn_emmc.img{
  hdimage {
  }

  partition imx-boot {
    in-partition-table = "no"
    image = "imx8-boot-sd.bin"
    offset = %IMXOFFSET%
  }

  partition boot {
    partition-type = 0xC
    bootable = "true"
    image = "boot.vfat"
    offset = 8M
  }
}

image sdcard.img {
  hdimage {
  }

  partition imx-boot {
    in-partition-table = "no"
    image = "imx8-boot-sd.bin"
    offset = %IMXOFFSET%
  }

  partition rootfs {
	offset = 8M
    partition-type = 0x83
    image = "rootfs.ext2"
  }
}
