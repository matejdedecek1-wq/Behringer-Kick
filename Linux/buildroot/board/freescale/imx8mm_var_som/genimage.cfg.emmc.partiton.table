# Minimal SD card image for the Freescale iMX8 boards
#
# We mimic the .sdcard Freescale's image format:
# * the SD card must have 33 kB free space at the beginning,
# * U-Boot is integrated into imx8-boot-sd.bin and is dumped as is,
# * a FAT partition at offset 8MB is containing Image and DTB files
# * a single root filesystem partition is required (ext2, ext3 or ext4)
#

image emmc.partition{
  size = 14G
  hdimage {
	gpt = "true"
	gpt-location = 7M
	disk-uuid = 8da16a96-64cb-44ef-9bd7-43cea57d091c
	gpt-no-backup = "true"
  }

  partition imx-boot {
    in-partition-table = "no"
    image = "imx8-boot-sd.bin"
    offset = %IMXOFFSET%
  }

  partition rootfs {
	partition-type-uuid = 0fc63daf-8483-4772-8e79-3d69d8477de4
	partition-uuid = 70f29e13-761e-461d-8a65-991d765941b7
	offset = 8M
	size = %BR2_TARGET_ROOTFS_EXT2_SIZE%
  }

  partition usr {
	partition-type-uuid = 0fc63daf-8483-4772-8e79-3d69d8477de4
	partition-uuid = 56d2e551-db06-46da-bb58-274c6ee725d2
	autoresize = "true"
  }
}
