# Minimal SD card image for the Freescale iMX8 boards
#
# We mimic the .sdcard Freescale's image format:
# * the SD card must have 33 kB free space at the beginning,
# * U-Boot is integrated into imx8-boot-sd.bin and is dumped as is,
# * a FAT partition at offset 8MB is containing Image and DTB files
# * a single root filesystem partition is required (ext2, ext3 or ext4)
#

image boot.vfat {
	vfat {
		label = "boot"
			files = {
				emmc.gpt.gz,
				rootfs.ext4.gz,
			}
	}
	size = 512M
}

image Image.vfat {
	vfat {
		label = "boot0"
			files = {
				Image.gz,
				imx8mm-var-som-symphony.dtb,
				imx8mm-var-som-symphony-legacy.dtb,
				imx8mm-var-som-symphony-legacy-m4.dtb,
				imx8mm-var-som-symphony-m4.dtb,
			}
	}
	size = 32M
}

image usr.ext4 {
	ext4{}
        mountpoint = "/usr"
	size=512M
}
image opt.ext4 {
	ext4{}
        mountpoint = "/opt"
	size=512M
}

image factory.ext4 {
	ext4{}
	size=512M
}


image sdcard_write_emmc.img{
	hdimage {
	}

	partition imx-boot {
		in-partition-table = "no"
			image = "imx8-boot-sd.bin"
			offset = %IMXOFFSET%
	}

	partition boot {
		partition-type = 0xC
			bootable = "true"
			image = "boot.vfat"
			offset = 8M
	}
}




image sdcard_linux.img {
	hdimage {
	}

	partition imx-boot {
		partition-type = 0xC
			bootable = "true"
			image = "Image.vfat"
	}
	partition rootfs {
		partition-type = 0x83
			image = "rootfs.ext2"
	}
	partition imx-boot1 {
		partition-type = 0xC
			bootable = "true"
			image = "Image.vfat"
	}

	partition rootfs1 {
		partition-type = 0x83
			image = "rootfs.ext2"
	}
	partition rootfs1 {
		partition-type = 0x83
			image = "rootfs.ext2"
	}
	partition usr {
		partition-type = 0x83
			image = "usr.ext4"
	}
	partition opt {
		partition-type = 0x83
			image = "opt.ext4"
	}
	partition fac {
		partition-type = 0x83
			image = "factory.ext4"
	}
}
